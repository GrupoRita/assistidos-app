{
  "expo": {
    "name": "Rita Atende",
    "slug": "rita-atende",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ritaatende",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "br.org.rita.atende",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Usamos a câmera para tirar a foto do assistido.",
        "NSPhotoLibraryUsageDescription": "Usamos suas fotos para escolher a foto do assistido."
      }
    },
    "android": {
      "package": "br.org.rita.atende",
      "adaptiveIcon": {
        "backgroundColor": "#005998",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.NFC",
        "android.permission.CAMERA"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF6EE",
          "image": "./assets/images/logo-rita.jpg",
          "imageWidth": 160
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Usamos a câmera para tirar a foto do assistido.",
          "photosPermission": "Usamos suas fotos para escolher a foto do assistido."
        }
      ],
      [
        "react-native-nfc-manager",
        {
          "nfcPermission": "Usamos o NFC para ler o cartão do assistido.",
          "includeNdefEntitlement": false
        }
      ],
      "expo-font"
    ],
    "extra": {
      "portalUrl": "https://portal.rita.org.br"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
